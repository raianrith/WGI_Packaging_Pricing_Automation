# Copy to .env — Supabase: Project Settings → API Keys
# https://supabase.com/dashboard/project/_/settings/api-keys
#
# VITE_SUPABASE_ANON_KEY = client-safe key only. Use either:
#   - Publishable key (sb_publishable_…) from “Publishable key”, or
#   - Legacy tab → “anon” “public” JWT (eyJ…)
# Never use Secret keys (sb_secret_…) or service_role in the browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Ops Review Slack notify (Edge Function secrets — NOT Vite) ---
# When someone clicks “Submit for Ops Review”, notify-ops-review posts to Slack.
#
# 1. Slack → https://api.slack.com/apps → Create New App → From scratch
# 2. Incoming Webhooks → On → Add New Webhook to Workspace → pick a channel
# 3. Copy the Webhook URL (https://hooks.slack.com/services/...)
# 4. Supabase Dashboard → Edge Functions → Secrets → add:
#      SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Productive.io (Edge Function secrets — NOT Vite) ---
# Approving a Solutions Directory request creates a 5-step task list in Productive.
# Add under Supabase Dashboard → Edge Functions → Secrets:
#   PRODUCTIVE_API_TOKEN=          # Personal access token from Productive → Settings → API
# Optional (defaults already target Weidert WGI DNA):
#   PRODUCTIVE_ORG_ID=47945
#   PRODUCTIVE_PROJECT_ID=825703
#   PRODUCTIVE_FOLDER_ID=1004078
#   PRODUCTIVE_WORKFLOW_STATUS_ID=160919
#   PRODUCTIVE_APP_SLUG=weidert-group
